{
  "name": "regie-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Pont de Régie : expose les sessions Claude Code et Codex de la Thor en WebSocket local.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "demo": "node scripts/demo-client.ts"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.107.0",
    "@agentclientprotocol/codex-acp": "2.6.0",
    "@agentclientprotocol/sdk": "2.6.0",
    "shell-quote": "1.12.0",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
