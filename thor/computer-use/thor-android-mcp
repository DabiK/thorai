#!/bin/bash
# Serveur MCP thor_android : mobile-mcp, épinglé dans /opt/thor-android.
# La télémétrie de mobile-mcp est coupée. adb (lancé par mobile-mcp et par
# mobilecli) passe par la socket privée du serveur adb ; les déclarations MCP
# des deux agents la donnent aussi, la valeur ci-dessous sert de repli.
export MOBILEMCP_DISABLE_TELEMETRY=1
# Mode mobilecli par défaut (ticket 14) : arbre d'interface fiable et tous les
# outils. Il ouvre des ports 127.0.0.1 sur la console (ses adb forward) et
# injecte un agent JVMTI dans l'appli débogable au premier plan, Régie comprise.
# Mode adb seul (input, uiautomator dump, screencap) : créer le fichier
# ci-dessous. install.sh ne le touche pas, il survit donc à une réinstallation.
# Une variable MOBILEMCP_LEGACY_ROBOT déjà posée l'emporte sur les deux.
ADB_ONLY=/home/dev/.config/thor-android/adb-seul
if [ -z "${MOBILEMCP_LEGACY_ROBOT+x}" ]; then
  if [ -e "$ADB_ONLY" ]; then
    export MOBILEMCP_LEGACY_ROBOT=1
  else
    export MOBILEMCP_LEGACY_ROBOT=0
  fi
fi
export ADB_SERVER_SOCKET=${ADB_SERVER_SOCKET:-localfilesystem:/home/dev/.thor-adb/server}
export PATH="/usr/bin:$PATH"
exec /usr/local/bin/node /opt/thor-android/node_modules/@mobilenext/mobile-mcp/lib/index.js "$@"
