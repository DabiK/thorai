#!/bin/bash
# thor-screen : les deux écrans de la console, par adb.
# Complète le serveur MCP thor_android (mobile-mcp), qui ne voit que l'écran haut.
#
#   thor-screen ids                         écrans : nom, displayId, id physique, taille
#   thor-screen capture haut|bas FICHIER    capture PNG de l'écran
#   thor-screen tap haut|bas X Y            toucher en X, Y (pixels de l'écran)
#   thor-screen swipe haut|bas X1 Y1 X2 Y2 [MS]   glisser, en MS millisecondes
#   thor-screen text haut|bas "TEXTE"       saisir dans le champ qui a le focus
#
# Appareil : $ANDROID_SERIAL, sinon celui retenu par start.sh, sinon le seul connecté.
set -euo pipefail

STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/thor-android

die() {
  printf 'thor-screen : %s\n' "$*" >&2
  exit 1
}

usage() {
  sed -n '5,9p' "$0" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

serial() {
  if [ -n "${ANDROID_SERIAL:-}" ]; then
    echo "$ANDROID_SERIAL"
    return
  fi
  if [ -s "$STATE_DIR/serial" ]; then
    cat "$STATE_DIR/serial"
    return
  fi
  local devices
  devices=$(adb devices 2>/dev/null | awk 'NR > 1 && $2 == "device" { print $1 }')
  [ -n "$devices" ] || die "aucun appareil adb. Lancez d'abord /opt/thor-android/start.sh."
  [ "$(wc -l <<<"$devices")" -eq 1 ] || die "plusieurs appareils adb ; précisez ANDROID_SERIAL."
  echo "$devices"
}

SERIAL=$(serial)
adb_() { adb -s "$SERIAL" "$@"; }

# Une ligne par écran : displayId, id physique, largeur x hauteur.
# L'écran haut est le displayId 0 ; l'écran bas est l'autre écran physique.
displays() {
  adb_ shell cmd display get-displays | tr -d '\r' |
    sed -n 's/.*Display id \([0-9][0-9]*\):.* real \([0-9]*\) x \([0-9]*\),.*uniqueId "local:\([0-9][0-9]*\)".*/\1 \4 \2x\3/p'
}

screen_line() {
  local name=$1 lines
  lines=$(displays)
  case "$name" in
    haut) awk '$1 == 0' <<<"$lines" | head -n 1 ;;
    bas) awk '$1 != 0' <<<"$lines" | head -n 1 ;;
  esac
}

screen_field() {
  local line
  case "$1" in
    haut | bas) ;;
    *) die "écran inconnu : $1 (haut ou bas)" ;;
  esac
  line=$(screen_line "$1")
  [ -n "$line" ] || die "écran $1 introuvable."
  awk -v f="$2" '{ print $f }' <<<"$line"
}

cmd=${1:-}
case "$cmd" in
  ids)
    for name in haut bas; do
      line=$(screen_line "$name")
      [ -n "$line" ] || continue
      awk -v n="$name" '{ printf "%s displayId=%s physique=%s taille=%s\n", n, $1, $2, $3 }' <<<"$line"
    done
    ;;
  capture)
    [ $# -eq 3 ] || usage
    physical=$(screen_field "$2" 2)
    adb_ exec-out screencap -p -d "$physical" > "$3"
    [ "$(head -c 4 "$3" | od -An -c | tr -d ' ')" = "211PNG" ] ||
      die "la capture n'est pas une image PNG (écran $2)."
    echo "$3"
    ;;
  tap)
    [ $# -eq 4 ] || usage
    display=$(screen_field "$2" 1)
    adb_ shell input -d "$display" tap "$3" "$4"
    ;;
  swipe)
    [ $# -eq 6 ] || [ $# -eq 7 ] || usage
    for n in "${@:3}"; do
      [[ "$n" =~ ^[0-9]+$ ]] || die "nombre attendu : $n"
    done
    display=$(screen_field "$2" 1)
    adb_ shell input -d "$display" swipe "${@:3}"
    ;;
  text)
    [ $# -eq 3 ] || usage
    display=$(screen_field "$2" 1)
    # input text lit %s comme une espace ; le texte passe par le shell de la
    # console, d'où les apostrophes.
    typed=${3// /%s}
    typed=${typed//\'/\'\\\'\'}
    adb_ shell "input -d $display text '$typed'"
    ;;
  *)
    usage
    ;;
esac
