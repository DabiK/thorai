    <!-- Les explications : huit mots au plus par phrase. Les commandes sont des données. -->
    <string-array name="game_setup_lead_welcome">
        <item>ThorAI pilote Claude Code, Codex et opencode.</item>
        <item>Tu parles, l’agent agit, tu valides.</item>
    </string-array>
    <string name="game_setup_note_welcome">Ce parcours prépare la console, étape par étape. Chaque étape se vérifie seule. X passe les étapes facultatives.</string>

    <string-array name="game_setup_lead_termux">
        <item>Les agents tournent dans une Debian, sous Termux.</item>
        <item>Une commande installe tout, une seule fois.</item>
    </string-array>
    <string-array name="game_setup_steps_termux">
        <item>Installe Termux depuis ses releases GitHub.</item>
        <item>Ouvre Termux et attends sa préparation.</item>
        <item>Y copie ces commandes : colle-les dans Termux.</item>
    </string-array>
    <string name="game_setup_note_termux">Sans Termux, A ouvre sa page en bas.</string>

    <string-array name="game_setup_lead_bridge">
        <item>ThorAI parle aux agents par un pont local.</item>
        <item>Termux le démarre quand ThorAI le demande.</item>
    </string-array>
    <string-array name="game_setup_steps_bridge">
        <item>Autorise ThorAI à lancer des commandes Termux.</item>
        <item>ThorAI confie une clé au pont.</item>
        <item>Le pont répond : l’étape passe au vert.</item>
    </string-array>
    <string name="game_setup_note_bridge">La clé ne quitte jamais la console.</string>

    <string-array name="game_setup_lead_voice">
        <item>Maintiens L2 et parle : ThorAI écrit.</item>
        <item>La transcription tourne sur la console, hors ligne.</item>
    </string-array>
    <string-array name="game_setup_steps_voice">
        <item>Autorise le micro.</item>
        <item>Télécharge le modèle de voix, une seule fois.</item>
    </string-array>
    <string name="game_setup_note_voice">Rien ne part sans un appui sur A.</string>

    <string-array name="game_setup_lead_notifications">
        <item>ThorAI te prévient quand un agent t’attend.</item>
        <item>Une validation, une question, une fin, un échec.</item>
    </string-array>
    <string name="game_setup_note_notifications">Le reste se consulte dans l’app.</string>

    <string-array name="game_setup_lead_console">
        <item>L2 et R2 marchent depuis toute appli.</item>
        <item>Les messages de l’agent passent par-dessus l’écran.</item>
    </string-array>
    <string-array name="game_setup_steps_console">
        <item>Ouvre Accessibilité, sur l’écran du bas.</item>
        <item>Choisis « ThorAI, mode console », puis active-le.</item>
        <item>Bloqué ? Infos de l’appli › ⋮ › Autoriser les paramètres restreints.</item>
    </string-array>
    <string name="game_setup_note_console">ThorAI lit seulement la manette, jamais l’écran.</string>

    <string-array name="game_setup_lead_android">
        <item>Les agents voient et pilotent les deux écrans.</item>
        <item>Ils passent par le débogage sans fil.</item>
    </string-array>
    <string-array name="game_setup_steps_android">
        <item>En haut : Débogage sans fil › Associer avec un code.</item>
        <item>Y copie les commandes, ouvre Termux en bas.</item>
        <item>Colle-les, puis saisis le port et le code.</item>
    </string-array>
    <!-- THOR_ANDROID=ok est la sortie du script, une donnée. -->
    <string name="game_setup_note_android" tools:ignore="Typos">Le script doit répondre THOR_ANDROID=ok. ThorAI rallumera ensuite le débogage sans fil.</string>

    <string-array name="game_setup_lead_agents">
        <item>Connecte au moins un agent pour travailler.</item>
        <item>Chaque compte reste dans les fichiers de l’agent.</item>
    </string-array>
    <string-array name="game_setup_steps_agents">
        <item>Codex : un code à saisir sur ton téléphone.</item>
        <item>Claude : claude auth login, dans la Debian.</item>
        <item>opencode : ta clé OpenCode Go.</item>
    </string-array>

    <string-array name="game_setup_lead_finish">
        <item>Crée ta première session avec A.</item>
        <item>Maintiens ensuite L2 pour parler à l’agent.</item>
    </string-array>
    <!-- L'accueil classique et son « Configurer » laissent la place au menu Start du hameau. -->
