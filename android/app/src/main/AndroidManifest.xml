<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Le pont, sur 127.0.0.1 (ADR 06). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Démarrer et arrêter le pont dans Termux ; demandée au premier lancement. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <!-- Rallumer le débogage sans fil au lancement ; accordée une fois depuis le Mac (pm grant). -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11 et plus : Termux doit être visible pour lui envoyer RUN_COMMAND. -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:name=".RegieApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Regie">

        <service android:name=".voice.MicrophoneService" android:exported="false" android:foregroundServiceType="microphone" />
        <!-- Écran du haut. -->
        <activity
            android:name=".TopActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Écran du bas, dans sa propre tâche, lancé sur le display 4 par l'écran du haut. -->
        <activity
            android:name=".BottomActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity="app.regie.bottom"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
