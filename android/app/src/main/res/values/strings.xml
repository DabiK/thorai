<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name">ThorAI</string>

    <!-- Le compteur de l'en-tête : les sessions chargées dans un agent, pas l'historique. -->
    <plurals name="overview_session_count">
        <item quantity="one">%d session active</item>
        <item quantity="many">%d sessions actives</item>
        <item quantity="other">%d sessions actives</item>
    </plurals>

    <!-- « Étape 3 sur 5 » : rien ne s'accorde en nombre, d'où PluralsCandidate ignoré. -->
    <string name="card_step_short" tools:ignore="PluralsCandidate">étape %1$d sur %2$d</string>
    <string name="card_wants_command">Commande à autoriser :</string>
    <string name="card_wants_file_change">Fichier à modifier :</string>
    <string name="card_wants_other">Demande ton accord</string>

    <!-- Où en est la dernière action. -->
    <string name="action_status_pending">en attente</string>
    <string name="action_status_in_progress">en cours</string>
    <string name="action_status_completed">terminée</string>
    <string name="action_status_failed">échouée</string>
    <string name="action_status_interrupted">interrompue</string>

    <string name="version_untested">version non testée</string>

    <string name="banner_awaiting">%1$s attend ta validation</string>
    <string name="banner_see">Voir</string>
    <!-- Courrier du jeu (ticket 49) : une validation dont la session n'est pas encore connue. -->
    <string name="courier_agent">Un agent</string>

    <!-- État du pont et marche à suivre, sans jargon (PRD, principes). -->
    <string name="bridge_connecting">Connexion au pont…</string>
    <string name="bridge_unreachable">Pont injoignable</string>
    <string name="bridge_hint_grant_run_command">Autorise les commandes Termux dans les permissions Android.</string>
    <string name="bridge_hint_termux_missing">Termux ne répond pas. Relance l’installation du pont dans Termux.</string>
    <string name="bridge_hint_token_missing">Clé du pont absente. Autorise les commandes Termux puis rouvre ThorAI.</string>
    <string name="bridge_hint_token_refused">Clé du pont refusée. Autorise les commandes Termux puis rouvre ThorAI.</string>
    <string name="bridge_hint_restarting">ThorAI relance le pont et se reconnecte seule.</string>

    <string name="mic_hold_l2">Maintiens L2 et parle</string>
    <string name="mic_l2_held">L2 maintenu</string>
    <string name="mic_r2_held">R2 maintenu</string>

    <plurals name="quit_busy">
        <item quantity="one">%d session travaille encore. Quitter l\'arrête.</item>
        <item quantity="many">%d sessions travaillent encore. Quitter les arrête.</item>
        <item quantity="other">%d sessions travaillent encore. Quitter les arrête.</item>
    </plurals>
    <string name="quit_confirm">Quitter</string>
    <string name="quit_cancel">Annuler</string>
    <string name="quit_stopping">Arrêt des sessions et du pont…</string>

    <!-- Avis brefs, à la place de la phrase sous le micro. -->
    <string name="notice_sending">Envoi…</string>
    <string name="delivery_prompt">Message envoyé.</string>
    <string name="delivery_steering">Consigne transmise à l’agent.</string>
    <string name="delivery_queued">En attente de la réponse en cours.</string>
    <string name="delivery_cancelled">Pas parti : la session a été interrompue.</string>
    <string name="delivery_unknown">Envoi non confirmé. Vérifie le fil avant de renvoyer.</string>
    <string name="delivery_not_sent">Le message n\'est pas parti.</string>
    <string name="notice_interrupting">Interruption demandée…</string>
    <string name="notice_interrupted">Interruption envoyée.</string>
    <string name="notice_interrupt_failed">Le pont n\'a pas pu l\'interrompre.</string>
    <string name="bridge_hint_start_external">Démarre le pont sur le Mac.</string>

    <!-- Mode console (ticket 25). -->
    <string name="console_service_label">ThorAI, mode console</string>
    <string name="console_service_description">Parle à l’agent depuis toute appli, L2 maintenu. Ses messages passent par-dessus l’écran du haut. ThorAI lit seulement la manette, jamais l’écran.</string>
    <string name="card_replying_to">En réponse à</string>
    <string name="notice_nothing_heard">Rien entendu. Aucun message envoyé.</string>
</resources>
